set(M1_ROOT ${CMAKE_CURRENT_LIST_DIR}/..)
set(M1_COMMON ${M1_ROOT}/firmware/common/app.cpp ${M1_ROOT}/firmware/common/display.cpp ${M1_ROOT}/firmware/common/output.cpp ${M1_ROOT}/firmware/common/screen_ui.cpp)
if(NOT DEFINED RADIOLIB_DIR)
  message(FATAL_ERROR "RADIOLIB_DIR must point to the pinned RadioLib source")
endif()
file(GLOB_RECURSE RADIO_SOURCES ${RADIOLIB_DIR}/src/*.cpp)
list(FILTER RADIO_SOURCES EXCLUDE REGEX "/hal/")
set(RADIO_DEFINES RADIOLIB_STATIC_ONLY=1 RADIOLIB_STATIC_ARRAY_SIZE=512)
if(NOT DEFINED M1_VERSION)
  set(M1_VERSION "dev")
endif()
if(NOT M1_VERSION MATCHES "^[a-zA-Z0-9.+_-]+$")
  message(FATAL_ERROR "Invalid M1_VERSION")
endif()
